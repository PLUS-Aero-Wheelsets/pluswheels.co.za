.hero {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    /* This links to your campaign shot */
    background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.2)), url('goblin-hero.jpg') center/cover no-repeat;
    padding: 0 5%;
}