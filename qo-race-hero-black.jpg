      margin-top: 40px;
    }
  }
</style>

<script>
(() => {
  const track = document.getElementById('sr-psc-template--29959249396053__sr_product_slide_and_color_aQQA74');
  if (!track) return;

  const prev = document.querySelector('.p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__arrow--prev');
  const next = document.querySelector('.p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__arrow--next');

  const slides = Array.from(track.children);
  const realCount = slides.length;

  // Infinite loop: clone first and last slide
  if (realCount >= 2) {
    const firstClone = slides[0].cloneNode(true);
    const lastClone = slides[realCount - 1].cloneNode(true);
    track.appendChild(firstClone);
    track.insertBefore(lastClone, slides[0]);
  }

  const totalSlides = () => track.children.length;
  const slideWidth = () => track.getBoundingClientRect().width;
  const currentIndex = () => Math.round(track.scrollLeft / slideWidth());

  const goTo = (idx, behavior = 'smooth') => {
    track.scrollTo({ left: idx * slideWidth(), behavior });
  };

  // Start at real first slide (index 1, after the prepended clone)
  if (realCount >= 2) goTo(1, 'instant');

  // After swipe settles, jump from clone to real slide
  let scrollTimer;
  track.addEventListener('scroll', () => {
    clearTimeout(scrollTimer);
    scrollTimer = setTimeout(() => {
      const idx = currentIndex();
      if (idx === 0) {
        goTo(totalSlides() - 2, 'instant');
      } else if (idx === totalSlides() - 1) {
        goTo(1, 'instant');
      }
    }, 120);
  });

  if (prev) prev.addEventListener('click', () => goTo(currentIndex() - 1));
  if (next) next.addEventListener('click', () => goTo(currentIndex() + 1));

  // Pass vertical wheel to page
  track.addEventListener('wheel', (e) => {
    if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
      window.scrollBy({ top: e.deltaY, behavior: 'auto' });
      e.preventDefault();
    }
  }, { passive: false });

  // Scroll position preservation between color variant pages
  const SCROLL_KEY = 'sr-psc-scroll';
  const savedY = sessionStorage.getItem(SCROLL_KEY);
  if (savedY !== null) {
    sessionStorage.removeItem(SCROLL_KEY);
    // Disable browser's own scroll restoration so Chrome doesn't override ours
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    // Double rAF ensures the browser has finished its own layout/restore pass
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        window.scrollTo({ top: parseInt(savedY, 10), behavior: 'instant' });
        document.documentElement.style.transition = 'opacity 0.2s ease';
        document.documentElement.style.opacity = '1';
      });
    });
  }
  document.querySelectorAll('.p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__buttons a:not(.sr-psc__btn--active)').forEach(btn => {
    btn.addEventListener('click', () => {
      sessionStorage.setItem(SCROLL_KEY, window.scrollY);
    });
  });
})();
</script>


