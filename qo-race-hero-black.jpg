<style>
  .p-template--29959249396053__sr_product_slide_and_color_aQQA74 {
    background: #000000;
    padding-top: 60px;
    padding-bottom: 60px;
    margin-top: -1px;
    margin-bottom: -1px;
  }

  /* Wrapper: full width, arrows positioned absolutely */
  .p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__slider-wrapper {
    position: relative;
  }

  /* Arrows */
  .p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.15);
    background: rgba(0,0,0,0.35);
    color: #fff;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    font-size: 2.6rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__arrow {
    display: none;
  }
  .p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__arrow:hover {
    border-color: var(--brand-col);
    background: rgba(236,201,96,0.1);
  }

  /* Track: full width with fade mask at edges */
  .p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 18%, black 82%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 18%, black 82%, transparent 100%);
  }
  .p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__track::-webkit-scrollbar { display: none; }

  /* Slides */
  .p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__slide img {
    width: 80vw;
    max-width: 900px;
    height: auto;
    object-fit: contain;
    user-select: none;
    pointer-events: none;
  }

  /* Color buttons */
  .p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__buttons {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 32px;
  }

  /* Button 1: black bg, white text/border — always */
  .p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__buttons .sr-psc__btn--1.button,
  .p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__buttons .sr-psc__btn--1.button:hover {
    background-color: #111 !important;
    border-color: #fff !important;
    color: #fff !important;
  }

  /* Button 2: white bg, black text/border — always */
  .p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__buttons .sr-psc__btn--2.button,
  .p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__buttons .sr-psc__btn--2.button:hover {
    background-color: #fff !important;
    border-color: #111 !important;
    color: #111 !important;
  }

  /* Active button: gold border, not clickable */
  .p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__buttons .sr-psc__btn--active.button,
