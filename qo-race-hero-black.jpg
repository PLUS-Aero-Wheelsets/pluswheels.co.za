      display: flex;
    }
    .p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__arrow--prev {
      left: 5%;
    }
    .p-template--29959249396053__sr_product_slide_and_color_aQQA74 .sr-psc__arrow--next {
      right: 5%;
    }
